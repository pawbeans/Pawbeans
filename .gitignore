# Third-party pipeline, rebuilt by scripts/setup-motion-stack.sh
OpenMontage/
.env
node_modules/
# HyperFrames working files
videos/*/snapshots/
videos/*/.thumbnails/
videos/*/.hyperframes/
# mg-styles-15 (house renderer), rebuilt by scripts/setup-motion-stack.sh
mg-styles-15/
# cel render outputs (keep stills for review, not frames or full renders)
films/*/out/frames/
films/*/out/*.wav
films/*/out/*.mp4
characters/*/model-sheet/out/frames/
review/*.mp4

# full-size key-frame stills are regenerable (scripts/cel-render.sh --stills); boards + hero stills are committed explicitly
films/*/out/stills/
# daily-film deliverables are sent to the owner, not committed (too large to keep daily)
films/*/review/*.mp4
films/*/review/*.wav
films/*/out/stems/
films/*/out/vo/raw/
films/*/review/voice-samples/
